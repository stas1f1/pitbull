━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  scene                                       checker     probe@0.85   inflation
  featuretools with default settings        VIOLATION         MISSED    +16.3 pp
  our own reference code, first version     VIOLATION         MISSED     +5.3 pp
  the same reference code after the fix         CLEAN        correct     +0.0 pp
  LOCATOR ← scene 2: our reference code, v1            patch → CLEAN  3: flat.review_score; flat.late; flat.delay_days
  LOCATOR ← scene 1: featuretools defaults             patch → CLEAN  1: items

  The checker fires where the industrial probe is silent, and stays silent where the code
  is correct. It parses nothing — it only compares outputs.

