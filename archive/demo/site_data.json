{
"name": "order_count",
"doc": "How many orders did the seller receive before the seed time?",
"source": "def order_count(db, t, sellers):\n    \"\"\"How many orders did the seller receive before the seed time?\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[h.ts <= t]\n    g = h[h.seller_id.isin(sellers)].groupby(\"seller_id\")\n    return g.order_id.nunique().to_frame(\"n_orders\").reindex(sellers)",
"leak": false,
"columns": [],
"cells": 0
},
{
"name": "average_review",
"doc": "Average review score of the seller's orders placed before the seed time.",
"source": "def average_review(db, t, sellers):\n    \"\"\"Average review score of the seller's orders placed before the seed time.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[h.ts <= t]\n    g = h[h.seller_id.isin(sellers)].groupby(\"seller_id\")\n    return g.review_score.mean().to_frame(\"review_mean\").reindex(sellers)",
"leak": true,
"columns": [
"review_mean"
],
"cells": 648
},
{
"name": "average_review_known",
"doc": "Average of the reviews that had been *written* by the seed time.",
"source": "def average_review_known(db, t, sellers):\n    \"\"\"Average of the reviews that had been *written* by the seed time.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[(h.ts <= t) & (h.review_ts <= t)]\n    g = h[h.seller_id.isin(sellers)].groupby(\"seller_id\")\n    return g.review_score.mean().to_frame(\"review_mean\").reindex(sellers)",
"leak": false,
"columns": [],
"cells": 0
},
{
"name": "late_share",
"doc": "Share of the seller's orders (placed before t) that were delivered late.",
"source": "def late_share(db, t, sellers):\n    \"\"\"Share of the seller's orders (placed before t) that were delivered late.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[h.ts <= t]\n    g = h[h.seller_id.isin(sellers)].groupby(\"seller_id\")\n    return g.late.mean().to_frame(\"late_share\").reindex(sellers)",
"leak": true,
"columns": [
"late_share"
],
"cells": 605
},
{
"name": "price_zscore",
"doc": "Seller's mean price, standardised by the mean and std of price over the whole table.",
"source": "def price_zscore(db, t, sellers):\n    \"\"\"Seller's mean price, standardised by the mean and std of price over the whole table.\"\"\"\n    h = db.tables[\"flat\"]\n    mu, sd = h.price.mean(), h.price.std()          # over the whole table\n    h = h[h.ts <= t]\n    m = h[h.seller_id.isin(sellers)].groupby(\"seller_id\").price.mean()\n    return ((m - mu) / sd).to_frame(\"price_z\").reindex(sellers)",
"leak": true,
"columns": [
"price_z"
],
"cells": 852
},
{
"name": "days_since_last",
"doc": "Days between the seller's last order before t and t.",
"source": "def days_since_last(db, t, sellers):\n    \"\"\"Days between the seller's last order before t and t.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[h.ts <= t]\n    last = h[h.seller_id.isin(sellers)].groupby(\"seller_id\").ts.max()\n    days = (t - last).dt.total_seconds() / 86400\n    return days.to_frame(\"days_since_last\").reindex(sellers)",
"leak": false,
"columns": [],
"cells": 0
},
{
"name": "recent_orders",
"doc": "Orders in the 30 days before the seed time.",
"source": "def recent_orders(db, t, sellers):\n    \"\"\"Orders in the 30 days before the seed time.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[(h.ts <= t) & (h.ts > t - pd.Timedelta(days=30))]\n    g = h[h.seller_id.isin(sellers)].groupby(\"seller_id\")\n    return g.order_id.nunique().to_frame(\"orders_30d\").reindex(sellers)",
"leak": false,
"columns": [],
"cells": 0
},
{
"name": "delivered_count",
"doc": "How many of the seller's orders have a delivery date.",
"source": "def delivered_count(db, t, sellers):\n    \"\"\"How many of the seller's orders have a delivery date.\"\"\"\n    h = db.tables[\"flat\"]\n    h = h[h.ts <= t]\n    h = h[h.seller_id.isin(sellers)]\n    n = h.deliv_ts.notna().groupby(h.seller_id).sum()\n    return n.to_frame(\"n_delivered\").reindex(sellers)",
"leak": true,
"columns": [
"n_delivered"
],
"cells": 679
}
